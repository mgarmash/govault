{
  "name": "write-import",
  "steps": [
    {
      "args": [
        "import",
        "bitwardenjson",
        "{{TMP}}/in.json"
      ],
      "stdout": "Imported {{TMP}}/in.json",
      "stderr": "",
      "exit": 0
    },
    {
      "args": [
        "import",
        "bitwardencsv",
        "{{TMP}}/in.csv"
      ],
      "stdout": "Imported {{TMP}}/in.csv",
      "stderr": "",
      "exit": 0
    },
    {
      "args": [
        "list",
        "items",
        "--search",
        "imported"
      ],
      "stdout": "[{\"type\":1,\"favorite\":true,\"reprompt\":0,\"id\":\"b0000002-0000-4000-8000-000000000002\",\"collectionIds\":[],\"object\":\"item\",\"folderId\":\"b0000001-0000-4000-8000-000000000001\",\"name\":\"Imported login\",\"notes\":\"n\",\"fields\":[{\"type\":0,\"name\":\"k\",\"value\":\"v\"}],\"login\":{\"uris\":[{\"uri\":\"https://imported.example.com\"}],\"fido2Credentials\":[],\"username\":\"iu\",\"password\":\"ip\",\"passwordRevisionDate\":null},\"passwordHistory\":[],\"creationDate\":\"{{TIME}}\",\"revisionDate\":\"{{TIME}}\",\"attachments\":[]},{\"type\":2,\"favorite\":false,\"reprompt\":0,\"id\":\"b0000003-0000-4000-8000-000000000003\",\"collectionIds\":[],\"object\":\"item\",\"folderId\":\"f0f0f0f0-aaaa-4bbb-8ccc-dddddddddddd\",\"name\":\"Imported note\",\"notes\":\"secret note\",\"fields\":[],\"secureNote\":{\"type\":0},\"passwordHistory\":[],\"creationDate\":\"{{TIME}}\",\"revisionDate\":\"{{TIME}}\",\"attachments\":[]}]",
      "stderr": "",
      "exit": 0
