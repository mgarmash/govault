    {
      "args": [
        "list",
        "folders"
      ],
      "stdout": "[{\"name\":\"CSV folder\",\"object\":\"folder\",\"id\":\"b0000004-0000-4000-8000-000000000004\"},{\"name\":\"Home\",\"object\":\"folder\",\"id\":\"f1f1f1f1-aaaa-4bbb-8ccc-dddddddddddd\"},{\"name\":\"Imported folder\",\"object\":\"folder\",\"id\":\"b0000001-0000-4000-8000-000000000001\"},{\"name\":\"Work\",\"object\":\"folder\",\"id\":\"f0f0f0f0-aaaa-4bbb-8ccc-dddddddddddd\"},{\"name\":\"No Folder\",\"object\":\"folder\",\"id\":\"\"}]",
      "stderr": "",
      "exit": 0
