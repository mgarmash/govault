    {
      "args": [
        "import"
      ],
      "stdout": "",
      "stderr": "`format` was not provided.",
      "exit": 1
    },
    {
      "args": [
        "import",
        "bitwardenjson"
      ],
      "stdout": "",
      "stderr": "`filepath` was not provided.",
      "exit": 1
