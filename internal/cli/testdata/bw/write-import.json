    {
      "args": [
        "list",
        "items",
        "--search",
        "csv"
      ],
      "stdout": "[{\"type\":1,\"favorite\":true,\"reprompt\":0,\"id\":\"b0000005-0000-4000-8000-000000000005\",\"collectionIds\":[],\"object\":\"item\",\"folderId\":\"b0000004-0000-4000-8000-000000000004\",\"name\":\"CSV login\",\"notes\":\"a note\",\"fields\":[{\"type\":0,\"name\":\"f1\",\"value\":\"v1\"},{\"type\":0,\"name\":\"f2\",\"value\":\"v2\"}],\"login\":{\"uris\":[{\"uri\":\"https://a.example.com\"},{\"uri\":\"https://b.example.com\"}],\"fido2Credentials\":[],\"username\":\"cu\",\"password\":\"cp\",\"passwordRevisionDate\":null},\"passwordHistory\":[],\"creationDate\":\"{{TIME}}\",\"revisionDate\":\"{{TIME}}\",\"attachments\":[]},{\"type\":2,\"favorite\":false,\"reprompt\":0,\"id\":\"b0000006-0000-4000-8000-000000000006\",\"collectionIds\":[],\"object\":\"item\",\"name\":\"CSV note\",\"notes\":\"body\",\"fields\":[],\"secureNote\":{\"type\":0},\"passwordHistory\":[],\"creationDate\":\"{{TIME}}\",\"revisionDate\":\"{{TIME}}\",\"attachments\":[]}]",
      "stderr": "",
      "exit": 0
